# Copy to .env and fill in what you want. Everything is optional.

# Require a password for the web UI (any username). Set this before
# exposing the app beyond your home network.
APP_PASSWORD=

# Draft scripts and write upload text with Claude.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Paid voice providers.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Parallel browser tabs per render (2 suits a NAS; raise on a fast PC).
RENDER_CONCURRENCY=2
